---
import { getCollection } from "astro:content";
import WidgetLayout from "@/components/common/WidgetLayout.astro";

// 从 content/ziyuan/quote.md 读取名言数据
const ziyuanEntries = await getCollection("ziyuan");
const quoteEntry = ziyuanEntries.find((e) => e.id === "quote");
const quotes = (quoteEntry?.data as { quotes?: { text: string; author: string }[] })
	?.quotes || [];

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

const quotesJson = JSON.stringify(quotes);
---

<WidgetLayout name="✨ 今日一言" id="quote-of-the-day" class={className} style={style}>
	<div class="quote-content">
		<blockquote class="quote-text">
			<span class="quote-mark">"</span>
			<span class="quote-body">正在抽选一言…</span>
			<span class="quote-mark">"</span>
		</blockquote>
		<cite class="quote-author">-- </cite>
	</div>
</WidgetLayout>

<script is:inline define:vars={{ quotesJson }}>
	// 每次页面加载随机抽选一条（含 Swup 页面切换）
	// 注意：桌面侧栏和移动端底部会渲染两个同 id 实例，必须全部更新
	(function () {
		var quotes = JSON.parse(quotesJson);
		function pick() {
			var q = quotes[Math.floor(Math.random() * quotes.length)];
			var text = q ? q.text : "";
			var author = "-- " + (q ? q.author : "");
			document
				.querySelectorAll("#quote-of-the-day .quote-body")
				.forEach(function (el) {
					el.textContent = text;
				});
			document
				.querySelectorAll("#quote-of-the-day .quote-author")
				.forEach(function (el) {
					el.textContent = author;
				});
		}
		pick();
		document.addEventListener("swup:contentReplaced", pick);
	})();
</script>

<style>
	.quote-content {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 0.5rem 0;
	}

	.quote-text {
		position: relative;
		font-style: italic;
		font-size: 0.9rem;
		line-height: 1.6;
		padding: 0 0.5rem;
		margin: 0;
	}

	.quote-mark {
		font-size: 1.5rem;
		line-height: 0;
		vertical-align: middle;
		color: var(--primary);
		opacity: 0.6;
		font-family: Georgia, serif;
	}

	.quote-author {
		display: block;
		text-align: right;
		font-size: 0.75rem;
		color: var(--content-meta);
		font-style: normal;
		margin-top: 0.25rem;
	}

	/* 深色模式优化 */
	:global(html.dark) .quote-text {
		color: #fff;
	}

	/* 悬停效果 */
	:global(.quote-content:hover .quote-text) {
		color: var(--primary);
		transition: color 0.2s ease;
	}
</style>
