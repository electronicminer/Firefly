---
import Comment from "@/components/comment/index.astro";
import WidgetLayout from "@/components/common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
---

<WidgetLayout name=" 留言板" id="guestbook-widget" class={className} style={style}>
	<Comment customPath="/guestbook/" />
</WidgetLayout>

<style>
	/* 让内嵌评论区撑满侧边栏卡片宽度 */
	:global(#guestbook-widget giscus-widget) {
		width: 100% !important;
	}
</style>
