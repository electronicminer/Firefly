---
import WidgetLayout from "@/components/common/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
---

<WidgetLayout name="📊 访问统计" id="site-visit" class={className} style={style}>
	<div class="grid grid-cols-2 gap-2 py-1">
		<div class="text-center rounded-lg bg-black/5 dark:bg-white/5 py-2.5 px-2">
			<div class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
				<span id="busuanzi_value_site_pv">0</span>
			</div>
			<div class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">访问量</div>
		</div>
		<div class="text-center rounded-lg bg-black/5 dark:bg-white/5 py-2.5 px-2">
			<div class="text-xl font-bold text-neutral-900 dark:text-neutral-100">
				<span id="busuanzi_value_site_uv">0</span>
			</div>
			<div class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">访客数</div>
		</div>
	</div>
	<p class="text-center text-[0.65rem] text-neutral-400 dark:text-neutral-500 mt-1">
		数据由不蒜子计数服务提供
	</p>
</WidgetLayout>

<script>
	// 不蒜子计数 - 免费、无需注册
	// 数据缓存在 busuanzi 官方服务，本地刷新不丢失
	function loadBusuanzi() {
		const script = document.createElement("script");
		script.src =
			"https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js";
		script.async = true;
		script.setAttribute("data-swup-ignore-script", "");
		document.body.appendChild(script);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", loadBusuanzi, { once: true });
	} else {
		loadBusuanzi();
	}
	// Swup 页面切换时重新加载
	document.addEventListener("astro:page-load", loadBusuanzi);
</script>
