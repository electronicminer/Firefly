---
import WidgetLayout from "@/components/common/WidgetLayout.astro";

// ── 年度节日提醒配置（可自由增删）───────────────────────
// 组件会自动找到「最近的下一个」节日来提醒。
// ⚠️ 农历节日（春节/端午/中秋等）每年公历日期都不同，需按年更新！
//    当前填的是 2026 年的公历日期。
const holidays = [
	{ name: "元旦", month: 1, day: 1 }, // 2026-01-01
	{ name: "春节", month: 2, day: 17 }, // 2026-02-17（农历，需按年更新）
	{ name: "清明", month: 4, day: 5 }, // 2026-04-05
	{ name: "劳动节", month: 5, day: 1 }, // 2026-05-01
	{ name: "端午", month: 6, day: 19 }, // 2026-06-19（农历，需按年更新）
	{ name: "中秋", month: 9, day: 25 }, // 2026-09-25（农历，需按年更新）
	{ name: "国庆", month: 10, day: 1 }, // 2026-10-01
];

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;
const holidaysJson = JSON.stringify(holidays);
---

<WidgetLayout name="⏳ 时间进度" id="time-progress" class={className} style={style}>
	<div class="py-1">
		<!-- 当前日期 -->
		<div
			id="tp-date"
			class="text-center font-semibold text-neutral-900 dark:text-neutral-100 mb-3"
		>
			正在加载...
		</div>

		<!-- 各周期进度 -->
		<div id="tp-progress" class="hidden">
			{
				[
					{ id: "year", label: "本年", unit: "天" },
					{ id: "month", label: "本月", unit: "天" },
					{ id: "week", label: "本周", unit: "天" },
					{ id: "day", label: "今日", unit: "小时" },
				].map((p) => (
					<div data-period={p.id} class="text-center py-1.5">
						<div class="tp-pct text-2xl font-bold text-(--primary) leading-none">-</div>
						<div class="tp-left mt-1 text-xs text-neutral-500 dark:text-neutral-400">
							{p.label}还剩 <span class="tp-num font-semibold text-neutral-700 dark:text-neutral-200">-</span> {p.unit}
						</div>
					</div>
				))
			}
		</div>

		<!-- 最近节日倒计时 -->
		<div
			id="tp-holiday"
			class="hidden mt-2 border-t border-(--line-divider) pt-3 text-center"
		>
			<div class="text-xs text-neutral-500 dark:text-neutral-400">
				距离<span class="tp-hname text-(--primary) font-medium">-</span>
			</div>
			<div class="tp-hdays text-3xl font-bold text-neutral-900 dark:text-neutral-100 leading-none mt-1">
				-
			</div>
			<div class="tp-hdate mt-1 text-xs text-neutral-400 dark:text-neutral-500">-</div>
		</div>
	</div>
</WidgetLayout>

<script define:vars={{ holidaysJson }}>
	const WEEKDAYS = ["周日", "周一", "周二", "周三", "周四", "周五", "周六"];

	function compute(now) {
		const startOfYear = new Date(now.getFullYear(), 0, 1);
		const endOfYear = new Date(now.getFullYear() + 1, 0, 1);
		const startOfMonth = new Date(now.getFullYear(), now.getMonth(), 1);
		const nextMonth = new Date(now.getFullYear(), now.getMonth() + 1, 1);
		const daysInYear = (endOfYear - startOfYear) / 86400000;
		const daysInMonth = (nextMonth - startOfMonth) / 86400000;

		// 周一作为一周起点：Mon=0 ... Sun=6
		const weekDay = (now.getDay() + 6) % 7;

		const todayStart = new Date(
			now.getFullYear(),
			now.getMonth(),
			now.getDate(),
		).getTime();
		const daysElapsedYear =
			Math.round((todayStart - startOfYear.getTime()) / 86400000) + 1;
		const daysElapsedMonth = now.getDate();

		const daysLeftInYear = daysInYear - daysElapsedYear;
		const daysLeftInMonth = daysInMonth - daysElapsedMonth;
		const daysLeftInWeek = 7 - (weekDay + 1);
		const hoursLeftInDay = 24 - now.getHours();

		return {
			year: {
				left: daysLeftInYear,
				pct: (daysElapsedYear / daysInYear) * 100,
			},
			month: {
				left: daysLeftInMonth,
				pct: (daysElapsedMonth / daysInMonth) * 100,
			},
			week: {
				left: daysLeftInWeek,
				pct: ((weekDay + 1) / 7) * 100,
			},
			day: {
				left: hoursLeftInDay,
				pct: (hoursLeftInDay / 24) * 100,
			},
		};
	}

	function fmtUnit(pct) {
		return pct.toFixed(1).replace(/\.0$/, "") + "%";
	}

	function fmtDate(d) {
		return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日 ${WEEKDAYS[d.getDay()]}`;
	}

	function pad(n) {
		return String(n).padStart(2, "0");
	}

	// 找到最近的下一个节日（含跨年回滚），返回 { name, days, date, isToday }
	function nearestHoliday(now, holidays) {
		const year = now.getFullYear();
		// 本年度各节日 + 明年元旦（保证跨年也能提醒）
		const candidates = holidays
			.map((h) => ({ name: h.name, date: new Date(year, h.month - 1, h.day) }))
			.concat({ name: holidays[0].name, date: new Date(year + 1, holidays[0].month - 1, holidays[0].day) })
			.filter((c) => c.date >= now)
			.sort((a, b) => a.date - b.date);

		if (candidates.length === 0) return null;
		const nearest = candidates[0];
		const days = Math.ceil((nearest.date - now) / 86400000);
		return {
			name: nearest.name,
			days: days === 0 ? "今天" : String(days),
			date: `${nearest.date.getFullYear()}-${pad(nearest.date.getMonth() + 1)}-${pad(nearest.date.getDate())}`,
			isToday: days === 0,
		};
	}

	function render() {
		const now = new Date();
		const dateEl = document.getElementById("tp-date");
		const progressEl = document.getElementById("tp-progress");
		const holidayEl = document.getElementById("tp-holiday");
		if (!dateEl || !progressEl || !holidayEl) return;

		dateEl.textContent = fmtDate(now);
		progressEl.classList.remove("hidden");

		const res = compute(now);
		["year", "month", "week", "day"].forEach((k) => {
			const container = document.querySelector(`[data-period="${k}"]`);
			if (!container) return;
			container.querySelector(".tp-pct").textContent = fmtUnit(res[k].pct);
			container.querySelector(".tp-num").textContent = String(res[k].left);
		});

		// 最近节日
		let holidays;
		try {
			holidays = JSON.parse(holidaysJson);
		} catch {
			holidays = [];
		}
		if (holidays.length === 0) return;
		const nh = nearestHoliday(now, holidays);
		if (!nh) return;
		holidayEl.classList.remove("hidden");
		holidayEl.querySelector(".tp-hname").textContent = nh.name;
		holidayEl.querySelector(".tp-hdays").textContent = nh.days;
		holidayEl.querySelector(".tp-hdate").textContent = nh.date;
	}

	render();
	document.addEventListener("astro:page-load", render);
</script>
